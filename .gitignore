# ============================================================
# 持仓侠 · Git 忽略规则
# 原则：入库只保留「源码 / 文档 / 可复现构建所需的配置与资源」。
#       运行时数据、构建产物、依赖、本机配置、一次性原型稿一律不入库。
# ============================================================

# ── 运行时数据与备份 ─────────────────────────────────────────
data/
data_test/
.bak/
*.db
*.db-journal
*.db-wal
*.db-shm
*.log

# ── 部署产物（commit|构建时间，由构建时自动生成）─────────────
VERSION
.deploy_tmp/
portfolio.tar.gz

# ── 构建产物与依赖 ──────────────────────────────────────────
# 前端构建产物（由 web/build.mjs 生成，供 //go:embed web/dist 使用）
web/dist/
/dist/
node_modules/
/portfolio.exe
/bsk_portfolio.exe

# ── 根目录遗留的旧前端 ──────────────────────────────────────
# 不参与构建，以 web/ 下版本为准（后者被 //go:embed web 嵌入）
/app.js
/index.html

# ── 本机专用配置与密钥 ──────────────────────────────────────
# 环境变量文件（.env.example 允许入库作为模板）
.env
.env.*
!.env.example

# ── 本地流程说明 / 设计文档（仅本机参考）────────────────────
# docs/ 只放行对外 API 文档（docs/api/）入库；其余 md 规格稿、设计稿、
# 改版方案、一次性 HTML 原型、过程截图全部留在本地。
# README 引用的截图统一放根目录 assets/，不埋进 docs 过程目录。
/docs/*
!/docs/api/
# 过程截图目录整体忽略（本地可看，不进 git）
/docs/screenshots/
DEPLOY.md
DESIGN_SYSTEM.md
# 根目录一次性规格 / 任务清单（本机参考，多为 AI 协作中间产物）
/spec.md
/tasks.md
# 按功能归档的规格稿 / 任务清单（specs/<feature>/spec.md + tasks.md），同属中间产物
/specs/

# ── WorkBuddy / trae 工作目录（记忆、会话、分享包）──────────
.workbuddy/
/.trae
.trae-html-share-packages/

# ── 本地脚本与临时校验 ──────────────────────────────────────
scripts/
analysis/
# 根 package.json / lock 只服务于 scripts/screenshot.mjs（playwright），
# 该脚本不入库，清单随之本地保留；前端依赖清单在 web/package.json（入库）。
/package.json
/package-lock.json
.verify/
.screenshots/
/shots/

# ── 原型设计稿（一次性 HTML 预览，仅本地参考）───────────────
tab-redesign-prototype/
finance-bar-prototype/
shield-prototype/
hero-prototype.html

# ── 本地验证用二进制（pf-smoke，跑全量构建前的冒烟库）────────
/pf-smoke.exe

# ── 归档与 bsk 本地预览验证产物（沙箱 DB / 截图 / 临时二进制）─
archive/
.bsk_data/
.bsk_shots/
.bsk_portfolio.exe
.bsk_sid

# ── Python（client/ 采集客户端，兜底 client/.gitignore）──────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ── 通用临时文件 / 编辑器与 OS 噪音 ─────────────────────────
*.tmp
*.bak
*.orig
*.rej
*.pid
*.stackdump
*.swp
*.swo
*~
.cache/
.idea/
.vscode/
Thumbs.db
Desktop.ini
.DS_Store

# 本地编译产物（go build -o pf.exe / go build 默认按模块名产出 portfolio）
# /pf*.exe 覆盖临时验证用的 pf-e.exe / pf-smoke.exe 等；portfolio.tgz 是 scripts/deploy.sh 的打包产物
/pf.exe
/pf*.exe
/pf*.exe~
/portfolio
/portfolio.tgz
/.tmp_*
# 一次性设计原型（与 docs/*-proposal.html 同策略：留在本地，不进版本库）
/rebalance-prototype/
/.verify/
/.commit-tmp/

# Go 本地构建缓存（go build 生成，勿入库）
.gocache/
/recent-flows-prototype
